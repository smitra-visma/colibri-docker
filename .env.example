# Host directory holding the converted int4 model. Required.
MODEL_DIR=/nvme/glm52_i4

# Model name served by the API and reported by /v1/models.
COLI_MODEL_ID=glm-5.2

# Host port for the API, and for the optional Swagger UI (--profile docs).
COLI_PORT=8000
DOCS_PORT=8080

# RAM budget in GB for the expert cache. 0 = let the engine decide.
COLI_RAM=0

# Bearer token required on /v1/* requests. Empty = no authentication.
COLI_API_KEY=

# Extra Host headers the DNS-rebinding guard accepts, comma separated,
# e.g. colibri.internal,192.168.1.10
COLI_ALLOWED_HOSTS=

# Upstream engine revision to build, and the target CPU ISA.
COLIBRI_REF=main
ARCH=x86-64-v3

# Image to run. The default is the prebuilt GHCR image; set it to a local tag
# (for example colibri-openapi) when you build the image yourself.
COLIBRI_IMAGE=ghcr.io/smitra-visma/colibri-docker:latest
# missing = pull only when absent locally. Use "never" to always use a local
# build, or "always" to pick up a newer published image on every start.
COLIBRI_PULL_POLICY=missing

# Hugging Face repository fetched by the `download` profile.
MODEL_REPO=mastouri/GLM-5.2-colibri-int4-g64-with-int8-mtp
# Token for a gated or private repository. Empty for public ones.
HF_TOKEN=
